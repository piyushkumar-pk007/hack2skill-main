{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "..",
    "rootDirs": ["src", "api", "../shared/src"],
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["../shared/src/index.ts"],
      "@shared/*": ["../shared/src/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "api"],
  "exclude": ["dist", "node_modules"]
}
